<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
{% include "analytics.html" %}
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " — deyan4/dev") if title else "Blog — deyan4/dev" %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="{{ title or 'Blog' }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ 'article' if date else 'website' }}">
<meta property="og:url" content="https://deyan4.github.io{{ page.url }}">
<meta property="og:site_name" content="deyan4/dev">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="https://deyan4.github.io/img/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if date %}
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:author" content="Deyan Chernogorski">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or 'Blog' }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://deyan4.github.io/img/og.png">
<meta name="author" content="Deyan Chernogorski">
<meta name="color-scheme" content="dark light">
<link rel="canonical" href="https://deyan4.github.io{{ page.url }}">
<link rel="alternate" type="application/rss+xml" title="deyan4/dev blog" href="/blog/feed.xml">
{% include "favicon.html" %}
<script>
  try {
    var t = localStorage.getItem('theme');
    if (!t) t = 'dark';
    document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
<link rel="stylesheet" href="/css/blog.css">
{%- if date %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BlogPosting", "headline": title, "description": description, "url": "https://deyan4.github.io" + page.url, "mainEntityOfPage": "https://deyan4.github.io" + page.url, "image": "https://deyan4.github.io/img/og.png", "datePublished": date | isoDate, "dateModified": date | isoDate, "inLanguage": "en-US", "author": { "@type": "Person", "name": "Deyan Chernogorski", "url": "https://deyan4.github.io/" }, "publisher": { "@type": "Person", "name": "Deyan Chernogorski", "url": "https://deyan4.github.io/" } } | dump | safe }}</script>
{%- else %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Blog", "name": "deyan4/dev blog", "description": description, "url": "https://deyan4.github.io" + page.url, "inLanguage": "en-US", "author": { "@type": "Person", "name": "Deyan Chernogorski", "url": "https://deyan4.github.io/" } } | dump | safe }}</script>
{%- endif %}
</head>
<body>
<canvas id="bg" aria-hidden="true"></canvas>
<div class="spot" aria-hidden="true"></div>
<div class="progress" id="progress" aria-hidden="true"></div>

<nav class="top">
  <div class="wrap">
    <a class="logo" href="/">@deyan4<i>/</i>dev</a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a class="btn primary nav-cta" href="https://dash.shopexperts.com/get-free-quote?cta_source=header_get_matched" target="_blank" rel="noopener">Free Quick Look</a>
    </div>
    <button class="toggle" id="theme" aria-label="Toggle light and dark theme">◐</button>
  </div>
</nav>

<main class="wrap" id="top">
  <div class="blog">
    <div class="blog-main">
{%- if date %}
      <a class="crumb" href="/blog/">← All posts</a>
      <section>
        <h1 class="title reveal">{{ title }}</h1>
        <p class="sub reveal">{{ date | readableDate }}{% if tag_label %} · {{ tag_label }}{% endif %}</p>
        <article class="news reveal">
          <div class="post-body">
{{ content | safe }}
          </div>
        </article>
      </section>
{%- else %}
{{ content | safe }}
{%- endif %}
    </div>
    {% include "sidebar.njk" %}
  </div>
  <div class="duo solo">
  {% include "final.html" %}
  </div>
</main>

{% include "footer.html" %}

{% include "consent.js.html" %}
<script>
  document.getElementById('yr').textContent = new Date().getFullYear();
  document.getElementById('theme').addEventListener('click', function () {
    var root = document.documentElement;
    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
  document.querySelectorAll('[data-mail]').forEach(function (a) {
    a.href = 'mailto:' + a.dataset.u + '@' + a.dataset.d + '?subject=' + encodeURIComponent('Shopify project');
    if (a.hasAttribute('data-show')) a.textContent = a.dataset.u + '@' + a.dataset.d;
  });
  /* reveal on scroll */
  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .1 });
  document.querySelectorAll('.reveal').forEach(function (n) { io.observe(n); });

  /* contact form (Formspree) */
  (function () {
    var f = document.getElementById('cform'), st = document.getElementById('cstatus');
    if (!f) return;
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var b = f.querySelector('button');
      b.disabled = true; st.className = 'status'; st.textContent = 'Sending…';
      fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw 0; f.reset(); st.className = 'status ok'; st.textContent = 'Thanks! Your message was sent. I\'ll get back to you soon.'; })
        .catch(function () { st.className = 'status err'; st.textContent = 'Something went wrong. Please try again or email me directly.'; })
        .then(function () { b.disabled = false; });
    });
  })();
</script>
<script src="/js/bg.js"></script>
</body>
</html>
