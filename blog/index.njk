---
layout: blog.njk
title: Blog
description: Articles on Shopify Plus development, app risk, performance and custom theme code.
permalink: /blog/
---
<section>
  <h1 class="title reveal">Blog</h1>
  <p class="sub reveal">Articles on Shopify development, app risk and store performance.</p>
  <div class="blog-list">
{%- for p in collections.posts | reverse %}
    <article class="news reveal">
      {%- if p.data.tag_label %}<span class="tag">{{ p.data.tag_label }}</span>{% endif %}
      <h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
      <time datetime="{{ p.date | isoDate }}">{{ p.date | readableDate }}</time>
      <p class="lede">{{ p.data.description }}</p>
      <a class="btn primary" href="{{ p.url }}"><span>Read the article →</span></a>
    </article>
{%- endfor %}
  </div>
</section>
